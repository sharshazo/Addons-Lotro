<?xml version="1.0"?>
<Plugin>
	<Information>
		<Name>Mapa del Mundo</Name>
		<Author>AI Agent</Author>
		<Version>2.5.0</Version>
		<Description>Mapa interactivo de Middle-earth con las 59 zonas del juego (nombre, nivel e imagen de referencia de cada zona) en espanol. Incluye buscador de zonas (por nombre o nivel), resaltado por nivel, filtro de expansiones, marcadores personalizados y comando /mapa.</Description>
	</Information>
	<Package>WorldMap_Addon.Main</Package>
</Plugin>
